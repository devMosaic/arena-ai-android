<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Verified update APKs wait here for the installer. This is filesDir, not cacheDir, so
         the platform cannot purge a download while the app is backgrounded in Settings. -->
    <files-path name="files_updates" path="updates" />
    <!-- Single camera stills handed back to the WebView after <input capture>. -->
    <cache-path name="cache_captures" path="captures" />
</paths>
